# Environment Configuration
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/jewelify?retryWrites=true&w=majority

# Twilio Configuration (for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Model Configuration
XGBOOST_MODEL_PATH=models/xgboost_jewelry_v1.model
MLP_MODEL_PATH=models/mlp_jewelry_v1.keras
PAIRWISE_FEATURES_PATH=models/pairwise_features.npy
HAAR_CASCADE_PATH=haarcascade_frontalface_default.xml

# API Configuration
PORT=5000

# Polling Configuration (for predictions)
POLLING_TIMEOUT_SECONDS=60
POLLING_INTERVAL_SECONDS=5