# Environment Configuration
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/jewelify?retryWrites=true&w=majority

# SMTP Configuration (for Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Jewelify

# Model Configuration
XGBOOST_MODEL_PATH=xgboost_jewelry_v1.model
MLP_MODEL_PATH=mlp_jewelry_v1.keras
HAAR_CASCADE_PATH=haarcascade_frontalface_default.xml

# S3 Recommendations
S3_BASE_URL=https://jewelify-images.s3.eu-north-1.amazonaws.com/Necklace with earrings_sorted_jpg/

# API Configuration
PORT=5000
MAX_UPLOAD_SIZE_MB=10

# Keep-alive (Render)
RENDER_URL=https://jewelify-server.onrender.com
KEEP_ALIVE_INTERVAL=840
KEEP_ALIVE_RETRIES=3

# Polling Configuration (for predictions)
POLLING_TIMEOUT_SECONDS=60
POLLING_INTERVAL_SECONDS=5
